PORT=3005

# Runtime environment
APP_ENV=development
APP_BIND_HOST=
APP_PUBLIC_ORIGIN=
APP_TRUSTED_PROXY_CIDRS=

# Access control
APP_ACCESS_MODE=local_only
APP_ALLOWED_IPS=127.0.0.1,::1
APP_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
APP_TRUST_PROXY=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Администратор
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_COMPLEXITY=true
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_IDLE_MINUTES=120
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=crm_assistant_session
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCK_MINUTES=15
API_RATE_LIMIT_REQUESTS_PER_MINUTE=120
LLM_RATE_LIMIT_REQUESTS_PER_MINUTE=20
WRITE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AUTH_REQUIRE_SEPARATE_APPROVER_FOR_CRITICAL=false
AUTH_REQUIRE_SEPARATE_APPROVER_FOR_EXTERNAL_MESSAGES=false
COMMUNICATION_ALLOW_UNVERIFIED_SEND_DEV=false
COMMUNICATION_LIVE_TEST_MAX_AGE_DAYS=90

BITRIX_WEBHOOK_URL=

BITRIX_OUTBOUND_TOKEN=

ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-opus-4-8

# HTTP или SOCKS5 прокси только для Claude (нужен вне РФ).
# Примеры:
# ANTHROPIC_PROXY=http://user:pass@host:8080
# ANTHROPIC_PROXY=socks5://user:pass@host:1080
ANTHROPIC_PROXY=

# --- Методология контактов (read-only аналитика) ---
# Сначала выполните action contact_field_audit и подставьте реальные ID полей/enum.
# Не коммитьте ID конкретного портала в git.

# Пользовательское поле статуса контакта (enumeration), например UF_CRM_...
BITRIX_CONTACT_STATUS_FIELD=

# Поле «теплоты» / этапа прожарки (опционально)
BITRIX_CONTACT_WARMUP_FIELD=

# Поле даты рождения (по умолчанию стандартное BIRTHDATE)
BITRIX_CONTACT_BIRTHDAY_FIELD=BIRTHDATE

# ID значений enum статуса через запятую (из contact_field_audit)
BITRIX_CONTACT_STATUS_WARMUP_VALUES=
BITRIX_CONTACT_STATUS_CYCLE_VALUES=
BITRIX_CONTACT_STATUS_COMMUNICATION_VALUES=
BITRIX_CONTACT_STATUS_LEAD_VALUES=
BITRIX_CONTACT_STATUS_PERSONAL_VALUES=
BITRIX_CONTACT_STATUS_SPAM_VALUES=
BITRIX_CONTACT_STATUS_DO_NOT_CONTACT_VALUES=
BITRIX_CONTACT_STATUS_CONGRATS_ONLY_VALUES=
BITRIX_CONTACT_STATUS_NO_CONTACT_VALUES=

# Шаблоны названий CRM-дел для поздравлений (через запятую, без учёта регистра)
BITRIX_BIRTHDAY_ACTIVITY_PATTERNS=день рождения,поздравить,поздравление

# Максимум страниц Bitrix24 на один аналитический обход (по 50 записей).
# 200 страниц ≈ 10 000 сущностей. При достижении лимита отчёт помечается truncated=true.
BITRIX_ANALYTICS_MAX_PAGES=200

# --- Safety layer (prepare → confirm → commit → audit → rollback) ---
# Массовые изменения выключены по умолчанию.
BITRIX_BULK_ACTIONS_ENABLED=false
BITRIX_BULK_MAX_ITEMS=20
BITRIX_BULK_CHUNK_SIZE=10
BITRIX_CONFIRMATION_TTL_MINUTES=15
BITRIX_ROLLBACK_TTL_HOURS=24
# BITRIX_OPERATIONS_DB_PATH=./data/operations.sqlite
# Предпочтительный путь общей БД (Safety + workspace). Если не задан — BITRIX_OPERATIONS_DB_PATH / data/operations.sqlite
# APP_DATABASE_PATH=./data/operations.sqlite

# Workspace / чаты
CHAT_RECENT_MESSAGES_LIMIT=30
CHAT_CONTEXT_MAX_CHARS=120000
PROJECT_CONTEXT_MAX_CHARS=80000
PROJECT_FILE_MAX_BYTES=2097152
PROJECT_FILES_MAX_COUNT=50
CHAT_AUTO_SUMMARY_ENABLED=true
CHAT_AUTO_SUMMARY_THRESHOLD_MESSAGES=40

# Client Context / Meeting Workflow
CLIENT_CONTEXT_MAX_CHARS=100000
CLIENT_TIMELINE_MAX_EVENTS=150
MEETING_TRANSCRIPT_MAX_CHARS=200000
CLIENT_CONTEXT_CACHE_TTL_SECONDS=60
# CLIENT_CONTEXT_ACTIVITIES_LIMIT=100
# CLIENT_CONTEXT_TASKS_LIMIT=50
# CLIENT_CONTEXT_TIMELINE_LIMIT=100

# Scheduled reports / notifications
APP_TIMEZONE=Asia/Almaty
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_LOCK_TTL_SECONDS=600
SCHEDULER_MAX_CONCURRENT_RUNS=1
SCHEDULED_REPORT_MAX_RUNTIME_SECONDS=600
SCHEDULED_REPORT_MIN_INTERVAL_MINUTES=15
SCHEDULED_REPORT_MISFIRE_GRACE_MINUTES=120

# Safe outbound messaging (single recipient only)
MESSAGE_DUPLICATE_WINDOW_MINUTES=10
MESSAGE_MAX_CHARS_WHATSAPP=4000
MESSAGE_MAX_CHARS_TELEGRAM=4000
MESSAGE_MAX_CHARS_EMAIL=50000
MESSAGE_MAX_CHARS_BITRIX_CHAT=4000
# COMMUNICATION_WEBHOOK_TOKEN=  # required to enable POST /communication-events/:channel
COMMUNICATION_LIVE_TEST_ENABLED=false
# Deprecated alias for COMMUNICATIONS_SEND_ENABLED — prefer canonical flag below.
# If both are set and disagree → COMMUNICATION_FLAGS_CONFLICT (send forced off, dry-run on).
# Do not rely on COMMUNICATION_SEND_ENABLED in new configs; it will be removed later.
# COMMUNICATION_SEND_ENABLED=false

# --- Communications Hub (Wazzup / campaigns / sequences) ---
# All dangerous flags OFF by default — app must not start sending after upgrade alone.
COMMUNICATIONS_ENABLED=false
COMMUNICATIONS_SEND_ENABLED=false
COMMUNICATIONS_DRY_RUN=true
# When send is enabled, require provider/channel certification before real send
COMMUNICATIONS_REQUIRE_CERTIFICATION=true

# Certification / live test harness (never point at production clients)
COMMUNICATION_TEST_CONTACT_ID=
COMMUNICATION_TEST_ALLOWED_CHANNELS=
COMMUNICATION_CERTIFICATION_CAMPAIGN_MAX_RECIPIENTS=3
COMMUNICATION_STORE_RAW_PROVIDER_PAYLOADS=false
# COMMUNICATION_STORE_RAW_PROVIDER_PAYLOADS_PRODUCTION_OVERRIDE=false
COMMUNICATION_CERTIFICATION_TTL_DAYS=90
COMMUNICATION_CERTIFICATION_ALLOW_MOCK=false
# Live certify driver (scripts/certify-communications-live.js) — off unless explicitly true
COMMUNICATION_LIVE_CERTIFY=false

COMMUNICATIONS_DEFAULT_TIMEZONE=Asia/Almaty
COMMUNICATIONS_QUIET_HOURS_START=19:00
COMMUNICATIONS_QUIET_HOURS_END=09:00
COMMUNICATIONS_ALLOWED_WEEKDAYS=1,2,3,4,5

COMMUNICATIONS_MAX_SINGLE_BATCH=20
COMMUNICATIONS_MAX_CAMPAIGN_RECIPIENTS=100
COMMUNICATIONS_MAX_MESSAGES_PER_MINUTE=10
COMMUNICATIONS_MAX_MESSAGES_PER_HOUR=100
COMMUNICATIONS_MAX_MESSAGES_PER_CONTACT_PER_DAY=1
COMMUNICATIONS_MIN_INTERVAL_SECONDS=5
COMMUNICATIONS_SEND_JITTER_SECONDS=15
COMMUNICATIONS_OUTBOX_LOCK_TTL_SECONDS=120
COMMUNICATIONS_OUTBOX_MAX_ATTEMPTS=5
COMMUNICATIONS_OUTBOX_BATCH_SIZE=10

WAZZUP_ENABLED=false
WAZZUP_API_BASE=https://api.wazzup24.com
WAZZUP_API_KEY=
WAZZUP_WEBHOOK_SECRET=
WAZZUP_REQUEST_TIMEOUT_MS=15000

# Official MAX Bot API only (disabled). Prefer Wazzup if transport max/maxbot appears in /v3/channels.
MAX_BOT_ENABLED=false
MAX_BOT_API_BASE=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_BOT_REQUEST_TIMEOUT_MS=15000
# Optional: enable POST /subscriptions (requires HTTPS webhook URL)
MAX_BOT_SUBSCRIBE_WEBHOOK=false
MAX_BOT_WEBHOOK_URL=
BITRIX_CONTACT_TELEGRAM_FIELD=
BITRIX_CONTACT_MAX_FIELD=
BITRIX_CONTACT_COMMUNICATION_CHANNEL_FIELD=
BITRIX_CONTACT_COMMUNICATION_CONSENT_FIELD=
BITRIX_CONTACT_LAST_CONTACT_FIELD=
BITRIX_CONTACT_WARMUP_STEP_FIELD=
BITRIX_CONTACT_FIRST_CONTACT_GROUND_FIELD=

COMMUNICATION_AUTO_CREATE_TIMELINE_COMMENT=false
COMMUNICATION_AUTO_CHANGE_CONTACT_STATUS=false
COMMUNICATION_AUTO_CREATE_ACTIVITY=false

COMMUNICATION_CONTEXT_RECENT_MESSAGES=30
COMMUNICATION_CONTEXT_MAX_CHARS=40000
COMMUNICATION_AUTO_SUMMARY_ENABLED=true
COMMUNICATION_AUTO_SUMMARY_THRESHOLD=50
# COMMUNICATION_OPT_OUT_PHRASES=не пишите,не пишите мне,отпишите,удалите мой номер,не интересно,стоп,stop,unsubscribe

# --- Bitrix REST resilience ---
BITRIX_READ_RETRY_ATTEMPTS=3
BITRIX_READ_RETRY_BASE_DELAY_MS=500
BITRIX_READ_TIMEOUT_MS=30000

# --- System prompt / action catalog budget ---
SYSTEM_PROMPT_MAX_CHARS=60000
ACTION_CATALOG_MAX_CHARS=20000

# --- LLM transport (none | corporate | self_hosted) ---
LLM_PROXY_MODE=none
# LLM_PROXY_URL=https://proxy.example:8443
# LLM_PROXY_USERNAME=
# LLM_PROXY_PASSWORD=
# LLM_PROXY_CA_CERT_PATH=
LLM_PROXY_ALLOW_INSECURE_TLS=false
# LLM_ALLOW_INSECURE_TLS_DEV=false
LLM_REQUEST_TIMEOUT_MS=60000
LLM_LOG_PAYLOADS=false

# --- Secrets at rest (required for AI keys / SMTP passwords) ---
# 64 hex chars or any passphrase (scrypt). Never commit real values.
SECRETS_MASTER_KEY=

# --- AI connections / voice / email feature flags ---
# User proxy profiles are disabled; proxy is only LLM_PROXY_* / ANTHROPIC_PROXY above.
CUSTOM_PROXY_ENABLED=false
PROMPT_PROFILES_ENABLED=true
USER_AI_PROVIDERS_ENABLED=true
CHAT_MODEL_SELECTION_ENABLED=true
VOICE_INPUT_ENABLED=true
VOICE_OUTPUT_ENABLED=false
WAZZUP_CHAT_SEND_ENABLED=true
EMAIL_SEND_ENABLED=false
EMAIL_DRY_RUN=true

# Live smoke-тест safety (только вручную, безопасные поля)
# BITRIX_LIVE_SAFETY_TEST_ENABLED=true

# --- Pilot deployment / observability ---
APP_ROOT=
APP_DATA_DIR=
APP_LOG_DIR=
APP_BACKUP_DIR=
APP_VERSION=
APP_RELEASE_ID=
APP_COMMIT_SHA=
APP_BUILD_TIME=
APP_INSTANCE_ID=
APP_MAINTENANCE_MODE=false
APP_READ_ONLY_MODE=false
BITRIX_WRITE_ENABLED=true
LLM_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=
LOG_TO_FILE=false
LOG_HTTP_ACCESS=false
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
PRODUCTION_SMOKE_TESTS_ENABLED=false
SMOKE_BASE_URL=
SMOKE_LOGIN_USERNAME=
SMOKE_LOGIN_PASSWORD=
DISK_WARNING_FREE_PERCENT=15
DISK_CRITICAL_FREE_PERCENT=5
